<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Passwords Plus</string>
	<key>CFBundleExecutable</key>
	<string>PasswordsPlus</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.maxkss.passwordsplus.companion</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Passwords Plus</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.0.0</string>
	<key>CFBundleVersion</key>
	<string>0</string>
	<!-- passwordsplus://connect, from the extension's welcome: connects the browser that opened it.
	     It does nothing else, whoever opens it (see LinkRequests). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.github.maxkss.passwordsplus.connect</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>passwordsplus</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- The agent role runs without a Dock icon; the setup window switches itself to a normal app. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSContactsUsageDescription</key>
	<string>Passwords Plus suggests the email addresses on your contact card when you sign up for websites.</string>
	<key>NSHumanReadableCopyright</key>
	<string>MIT License. Not affiliated with Apple Inc.</string>
	<!-- Sparkle: no appcast (SUFeedURL), so this build never offers updates. To ship updates, add your
	     own SUFeedURL and the SUPublicEDKey of your own Sparkle key (see docs/release.md). -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<key>SURequireSignedFeed</key>
	<true/>
</dict>
</plist>
